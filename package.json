{
  "name": "personal-portfolio-app",
  "productName": "PersonalPortfolioApp",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:exe": "npm run build && electron-packager . PersonalPortfolioApp --platform=win32 --arch=x64 --out=release-builds --overwrite --prune=true",
